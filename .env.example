MAPBOX_TOKEN=pk.your-public-token
# Optional. Leave it empty to run without the AI: the chat says it needs a key and the
# recommendations come from fixed rules. Put a real key here only to turn the AI on.
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://malas:malas@localhost:5433/malas_ngoding
# One-click demo sign-in (the "Masuk sebagai demo" buttons). On by default; set it to 0 to switch it off,
# for example on a public deployment.
DEMO_LOGIN=1
